# Google AI Studio / Gemini API key. Server-side only.
GEMINI_API_KEY=

# Model ID; verify availability for the key before relying on it.
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional read-only GitHub token; useful for authenticated rate limits (60/hr unauthenticated vs 5,000/hr authenticated).
GITHUB_TOKEN=

# Optional request timeout in milliseconds (default: 60000)
ANALYSIS_TIMEOUT_MS=60000

# Max screenshot size in bytes (default: 5MB)
MAX_SCREENSHOT_BYTES=5242880
